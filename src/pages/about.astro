---
import Layout from '../layouts/Layout.astro';

// Base-aware asset paths (root + GitHub Pages sub-path).
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const asset = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const principles = [
  { title: 'Governed, not promotional', body: 'We operate under defined structures rather than chase attention. Substance precedes presentation.' },
  { title: 'Long-term oriented', body: 'Capital is committed with a long horizon. We measure continuity in decades, not quarters.' },
  { title: 'Multi-asset class', body: 'Allocation spans asset classes, unconstrained by any single mandate or product.' },
  { title: 'Structured for durability', body: 'Ownership, oversight and execution are held separately so the platform endures beyond any individual.' },
];
---

<Layout
  title="About — Infinita Holdings LLC"
  description="Infinita is a privately held capital platform governed under a defined structure separating ownership, oversight and execution."
>
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">About Infinita</p>
      <h1>Governed for continuity.</h1>
      <p class="lede">
        Infinita is a privately held capital platform governed for long-term
        continuity and disciplined allocation.
      </p>
    </div>
  </section>

  <!-- Brand mark -->
  <section class="mark-section">
    <figure class="mark">
      <img
        src={asset('logo.jpg')}
        alt="The Infinita infinity mark in gold and black — Sovereign · Disciplined · Enduring."
        width="1536"
        height="1024"
      />
    </figure>
  </section>

  <!-- Purpose -->
  <section class="section">
    <div class="container story">
      <div>
        <p class="eyebrow">Purpose</p>
        <h2>A permanent owner.</h2>
      </div>
      <div class="story__body">
        <p>
          Decisions are made with a long horizon and a permanent ownership
          mindset. Infinita is structured to hold and steward capital across
          cycles and generations, free from the pressures of external mandates
          or redemption calendars.
        </p>
        <p>
          The platform is privately held. It exists to allocate capital with
          discipline — quietly, durably, and on its own terms.
        </p>
      </div>
    </div>
  </section>

  <!-- Governance -->
  <section class="section section--paper-pure">
    <div class="container story">
      <div>
        <p class="eyebrow">Governance</p>
        <h2>Separation by design.</h2>
      </div>
      <div class="story__body">
        <p>
          Infinita is governed under a defined structure separating ownership,
          oversight and execution.
        </p>
        <ul class="layers">
          <li><strong>Ownership</strong> is held by a family trust.</li>
          <li><strong>Oversight</strong> is exercised through a dedicated family council.</li>
          <li><strong>Execution</strong> — capital allocation — is carried out by a separate management entity.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Approach</p>
      <h2>Principles that hold.</h2>
      <div class="values">
        {principles.map((v) => (
          <article class="value">
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- What Infinita is not -->
  <section class="section section--dark">
    <div class="container clarify">
      <hr class="rule" />
      <p class="clarify__statement">
        Infinita is not a fund nor a financial product company. Nothing on this
        site is an offer, solicitation, or investment advice.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4.5rem, 11vw, 8rem); }

  /* Brand infinity mark, on its light backdrop */
  .mark-section { padding-block: 0; }
  .mark {
    margin: 0;
    max-width: 60rem;
    margin-inline: auto;
  }
  .mark img { width: 100%; height: auto; }

  .story {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }
  .story__body p:last-child { margin-bottom: 0; }

  .layers {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .layers li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .layers li strong { color: var(--gold); font-weight: 600; }

  .values {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }
  .value { border-top: 2px solid var(--gold); padding-top: 1.25rem; }
  .value h3 { margin-bottom: 0.5rem; }
  .value p { color: var(--muted); margin: 0; }

  .clarify__statement {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.45;
    color: var(--paper);
    max-width: 34ch;
    margin: 0;
  }

  @media (max-width: 820px) {
    .story { grid-template-columns: 1fr; gap: 1.5rem; }
    .values { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
